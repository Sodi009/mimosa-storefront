# Copy this file to .env.local and fill in your own values.

# Your store's myshopify domain, e.g. mimosa-bkk.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (Settings > Apps > Develop apps > your app > API credentials)
# This is a PUBLIC token meant for client-side/storefront use — it only grants read access
# to products/collections and permission to create carts, never admin access.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-api-token

# API version — update periodically, see https://shopify.dev/docs/api/storefront
SHOPIFY_STOREFRONT_API_VERSION=2024-10

# WhatsApp number that receives orders, digits only, with country code, no "+" or spaces.
# e.g. 66812345678 for a Thai number, 971504036705 for a UAE number.
NEXT_PUBLIC_WHATSAPP_NUMBER=971504036705

# Google Apps Script web app URL that powers order tracking (?action=track&q=...).
# Deploy > Manage deployments in the Apps Script editor to get this URL.
NEXT_PUBLIC_TRACKING_API_URL=https://script.google.com/macros/s/your-deployment-id/exec
